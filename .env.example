# ViralMotionStudio SaaS & YouTube Data API v3 Configuration
PORT=5000

# Subdomain & Public Origin (for production live hosting on toolio.tech)
APP_DOMAIN=viralmotionstudio.toolio.tech
PUBLIC_APP_URL=https://viralmotionstudio.toolio.tech
CORS_ORIGINS=https://viralmotionstudio.toolio.tech,https://ViralMotionStudio.toolio.tech,http://localhost:5173,http://localhost:5000

# Security Secrets (generate strong 64-hex secrets in production)
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-32plus-char-secret
AUTH_SECRET=replace-with-a-long-random-64-hex-session-secret
OWNER_EMAIL=

# Google Cloud OAuth 2.0 Client (Application type: Web application)
# Add BOTH localhost and your live domain to Authorized Redirect URIs in Google Cloud Console:
#   - http://localhost:5000/api/youtube/oauth/callback
#   - https://viralmotionstudio.toolio.tech/api/youtube/oauth/callback
#   - https://viralmotionstudio.toolio.tech/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/youtube/oauth/callback
GOOGLE_AUTH_REDIRECT_URI=

# Stripe Billing (leave blank to use built-in Sandbox SaaS Checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: MongoDB & Redis
MONGODB_URI=
REDIS_URL=
